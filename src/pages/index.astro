---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="landing">
    <h1 class="title">Alexandria</h1>
    <p class="tagline">Product knowledge for AI-native teams</p>
  </main>
  <footer class="footer">
    <p>
      A <a href="https://sociotechnica.org" target="_blank" rel="noopener noreferrer"
        >SocioTechnica</a
      > Product
    </p>
  </footer>
</Layout>

<style>
  .landing {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .tagline {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 300;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }

  .footer {
    padding: 2rem;
    text-align: center;
  }

  .footer p {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 300;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .footer a {
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .footer a:hover {
    opacity: 0.8;
  }
</style>
