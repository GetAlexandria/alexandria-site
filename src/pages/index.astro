---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="landing">
    <div class="hero">
      <picture>
        <source srcset="/hero.webp" type="image/webp" />
        <img src="/hero.jpg" alt="A futuristic vision of the ancient Library of Alexandria" class="hero-img" />
      </picture>
      <div class="hero-overlay"></div>
    </div>
    <div class="content">
      <h1 class="title">Alexandria</h1>
      <p class="tagline">The operating system for AI-native organizations</p>
    </div>
  </main>
  <footer class="footer">
    <p>
      A <a href="https://sociotechnica.org" target="_blank" rel="noopener noreferrer"
        >SocioTechnica</a
      > Product
    </p>
  </footer>
</Layout>

<style>
  .landing {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    position: relative;
  }

  .hero {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 2rem 0;
  }

  .hero-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 4px;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
  }

  .hero-overlay {
    position: absolute;
    inset: 2rem 2rem 0;
    border-radius: 4px;
    background: linear-gradient(to bottom, transparent 50%, var(--color-bg) 100%);
    pointer-events: none;
  }

  .content {
    position: relative;
    margin-top: -3rem;
    padding: 0 2rem;
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .tagline {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 300;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
  }

  .footer {
    padding: 2rem;
    text-align: center;
  }

  .footer p {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 300;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .footer a {
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .footer a:hover {
    opacity: 0.8;
  }
</style>
