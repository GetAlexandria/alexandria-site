---
// TopNav - Sticky navigation with Alexandria wordmark
---

<nav class="top-nav" aria-label="Primary">
  <div class="top-nav-inner">
    <a class="site-logo" href="/" aria-label="Alexandria home">
      <span class="wordmark">ALEXANDRIA</span>
    </a>
    <div class="nav-links">
      <a href="/onboarding">Talk to us</a>
      <a href="/onboarding">Install</a>
      <a href="/book">Book</a>
      <a href="/updates">Updates</a>
    </div>
  </div>
</nav>

<style>
  .top-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(15, 15, 20, 0.92);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid rgba(232, 228, 220, 0.08);
  }

  .top-nav-inner {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0.75rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-logo {
    text-decoration: none;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 400;
    letter-spacing: 0.2em;
    color: var(--color-cream);
    transition: color 0.2s ease;
  }

  .site-logo:hover .wordmark {
    color: var(--color-amber);
  }

  .nav-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    font-family: var(--font-display);
    font-size: 1.1rem;
  }

  .nav-links a {
    color: var(--color-cream-muted);
    text-decoration: none;
    border-bottom: 1.5px solid transparent;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--color-amber);
    border-bottom-color: var(--color-amber);
  }

  @media (max-width: 768px) {
    .wordmark {
      font-size: 1.2rem;
    }

    .nav-links {
      gap: 0.75rem;
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .top-nav-inner {
      flex-direction: column;
      padding: 0.5rem 1rem;
      gap: 0.5rem;
    }

    .wordmark {
      font-size: 1.1rem;
    }

    .nav-links {
      justify-content: center;
      gap: 0.5rem 0.75rem;
      font-size: 0.85rem;
    }
  }
</style>
